{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/*.gen.ts", "!**/dist", "!**/.wrangler"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "style": {
        "noEnum": "error",
        "noNamespace": "error",
        "noNonNullAssertion": "error",
        "noParameterProperties": "error",
        "noDefaultExport": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 400 }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@/api/visitor-keys": {
                "importNames": ["useHasVisitorKey"],
                "message": "Read whether this browser runs on a key from useKeyReach in @/api/key-reach, the one answer every screen shares."
              }
            }
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 50 }
        }
      },
      "performance": {
        "noReExportAll": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.cjs",
        ".dependency-cruiser.cjs"
      ],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "complexity": { "noExcessiveLinesPerFunction": "off" }
        }
      }
    },
    {
      "includes": ["apps/platform/src/routes/**"],
      "linter": {
        "rules": {
          "style": { "useFilenamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["apps/platform/src/api/key-reach.ts"],
      "linter": {
        "rules": {
          "style": { "noRestrictedImports": "off" }
        }
      }
    }
  ]
}
