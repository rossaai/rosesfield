{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rosesfield",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev address keeps answering when bun run deploy --domain puts
  // the deployment on a domain of the account, such as rosesfield.com.
  "workers_dev": true,
  // The migration modules of packages/generation, packages/library and this
  // gateway read import.meta.url when they load. Workers gives a module no file
  // URL, so the bundle defines one. The migrations themselves run through
  // wrangler d1.
  "define": { "import.meta.url": "\"file:///bundle/worker.js\"" },
  "assets": {
    "directory": "../../apps/platform/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/share", "/share/*", "/"]
  },
  // Public mode: each visitor brings their own Comfy key. The deployment holds
  // no key. SESSION_SECRET is a secret, set with wrangler secret put.
  "vars": {
    "MODE": "public",
    "RETENTION_DAYS": "30",
    "SESSION_REQUESTS_PER_MINUTE": "600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rosesfield",
      "migrations_dir": "../..",
      "migrations_pattern": "../../*/*/drizzle/*.sql"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rosesfield-assets" }],
  "durable_objects": {
    "bindings": [
      { "name": "WATCHERS", "class_name": "RunWatcher" },
      { "name": "AGENTS", "class_name": "AgentHost" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunWatcher"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentHost"] }
  ],
  // Public mode deletes the work of every account whose last visit is older
  // than RETENTION_DAYS, and every shared result older than 90 days, once an
  // hour.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "env": {
    // A private owner link: owner mode on one Comfy key, with a spend cap set by
    // SPEND_CAP_CREDITS. OWNER_TOKEN and COMFY_API_KEY are secrets, set with
    // wrangler secret put --env judge.
    "judge": {
      "name": "rosesfield-judge",
      "define": { "import.meta.url": "\"file:///bundle/worker.js\"" },
      "vars": {
        "MODE": "owner",
        "RETENTION_DAYS": "30",
        "SESSION_REQUESTS_PER_MINUTE": "600",
        "SPEND_CAP_CREDITS": "800"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rosesfield-judge",
          "migrations_dir": "../..",
          "migrations_pattern": "../../*/*/drizzle/*.sql"
        }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "rosesfield-judge-assets" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "WATCHERS", "class_name": "RunWatcher" },
          { "name": "AGENTS", "class_name": "AgentHost" }
        ]
      },
      "triggers": { "crons": ["17 * * * *"] }
    }
  }
}
