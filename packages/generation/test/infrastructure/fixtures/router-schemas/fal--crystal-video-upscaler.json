                    "maximum": 200,
                    "minimum": 1,
                    "type": "number"
                  },
                  "video_url": {
                    "description": "URL of the input video (MP4, MOV, WebM, M4V or GIF).",
                    "type": "string"
                  }
                },
                "required": ["video_url"],
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
