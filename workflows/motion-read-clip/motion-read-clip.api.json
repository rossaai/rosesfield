{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "clip.mp4"
    },
    "_meta": {
      "title": "Your clip"
    }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": ["1", 0],
      "start_time": 0,
      "duration": 10,
      "strict_duration": false
    },
    "_meta": {
      "title": "The first 10 seconds"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["2", 0]
    },
    "_meta": {
      "title": "GetVideoComponents"
    }
  },
  "4": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["3", 0]
    },
    "_meta": {
      "title": "GetImageSize"
    }
  },
  "5": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(768, min(a, b))",
      "values.a": ["4", 0],
      "values.b": ["4", 1]
    },
    "_meta": {
      "title": "Short side, at most 768"
    }
  },
  "6": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["3", 0],
      "resize_type": "scale shorter dimension",
      "resize_type.shorter_size": ["5", 1],
      "scale_method": "area"
    },
    "_meta": {
      "title": "Frames at the short side"
    }
  },
  "7": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["6", 0],
      "resize_type": "scale to multiple",
      "resize_type.multiple": 2,
      "scale_method": "area"
    },
    "_meta": {
      "title": "Even sides"
    }
  },
  "10": {
    "class_type": "DownloadAndLoadDepthAnythingV3Model",
    "inputs": {
      "model": "da3mono_large.safetensors",
      "precision": "auto",
      "attention": "auto"
    },
    "_meta": {
      "title": "Depth Anything 3 Mono-Large"
    }
  },
  "11": {
    "class_type": "DepthAnything_V3",
    "inputs": {
      "da3_model": ["10", 0],
      "images": ["7", 0],
      "normalization_mode": "V2-Style",
      "resize_method": "resize",
      "invert_depth": false,
      "keep_model_size": false
    },
    "_meta": {
      "title": "Depth of every frame, near is white"
    }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": ["3", 2]
    },
    "_meta": {
      "title": "CreateVideo"
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "motion-read-clip/depth",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "Depth video"
    }
  },
  "20": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": {
      "title": "SAM 3.1"
    }
  },
  "21": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "the person",
      "clip": ["20", 1]
    },
    "_meta": {
      "title": "What to find, one per comma"
    }
  },
  "22": {
    "class_type": "SAM3_VideoTrack",
    "inputs": {
      "images": ["7", 0],
      "model": ["20", 0],
      "conditioning": ["21", 0],
      "detection_threshold": 0.5,
      "max_objects": 3,
      "detect_interval": 1
    },
    "_meta": {
      "title": "Track each target"
    }
  },
  "23": {
    "class_type": "SAM3_TrackToMask",
    "inputs": {
      "track_data": ["22", 0],
      "object_indices": ""
    },
    "_meta": {
      "title": "Every target in one mask"
    }
  },
  "25": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": ["23", 0]
    },
    "_meta": {
      "title": "MaskToImage"
    }
  },
  "27": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["25", 0],
      "fps": ["3", 2]
    },
    "_meta": {
      "title": "CreateVideo"
    }
  },
  "28": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["27", 0],
      "filename_prefix": "motion-read-clip/mask",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "Mask video, targets white"
    }
  },
  "30": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": ["7", 0],
      "batch_index": 0,
      "length": 1
    },
    "_meta": {
      "title": "First frame"
    }
  },
  "31": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["30", 0],
      "filename_prefix": "motion-read-clip/first-frame"
    },
    "_meta": {
      "title": "First frame"
    }
  }
}
