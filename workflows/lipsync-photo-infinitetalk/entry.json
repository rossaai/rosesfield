{
  "name": "lipsync-photo-infinitetalk",
  "title": "Lip sync: a talking video from a photo and audio with InfiniteTalk",
  "description": "Makes a video of the person in your photo speaking your audio with the core WanInfiniteTalkToVideo node on Wan 2.1 I2V 14B in single-speaker mode, in up to 4 passes that each continue from the last frames of the one before, then trims the video to the length of the audio. Built from Comfy's template video_wan2_1_infinitetalk.",
  "mediaType": "video",
  "openSource": true,
  "models": [
    "Wan2_1-I2V-14B-480p_fp8_e4m3fn_scaled_KJ.safetensors",
