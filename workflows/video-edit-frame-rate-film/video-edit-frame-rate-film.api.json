{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "clip.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["1", 0]
    }
  },
  "3": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["2", 0]
    }
  },
  "4": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(1080, min(a, b))",
      "values.a": ["3", 0],
      "values.b": ["3", 1]
    }
  },
  "5": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["2", 0],
      "resize_type": "scale shorter dimension",
      "scale_method": "area",
      "resize_type.shorter_size": ["4", 1]
    }
  },
  "6": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["5", 0],
      "resize_type": "scale to multiple",
      "scale_method": "area",
      "resize_type.multiple": 2
    }
  },
  "7": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["6", 0]
    }
  },
  "8": {
    "class_type": "FrameInterpolationModelLoader",
    "inputs": {
      "model_name": "film_net_fp16.safetensors"
    }
  },
  "9": {
    "class_type": "FrameInterpolate",
    "inputs": {
      "interp_model": ["8", 0],
      "images": ["6", 0],
      "multiplier": 2
    }
  },
  "10": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a * 2",
      "values.a": ["2", 2]
    }
  },
  "11": {
    "class_type": "PrimitiveBoolean",
    "inputs": {
      "value": true
    }
  },
  "12": {
    "class_type": "ComfySwitchNode",
    "inputs": {
      "switch": ["11", 0],
      "on_true": ["2", 1]
    }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["9", 0],
      "fps": ["10", 0],
      "audio": ["12", 0]
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "video-edit/frame-rate",
      "format": "mp4",
      "format.codec": "h264"
    }
  }
}
