      "type": "scalar"
    },
    "width": {
      "nodeId": "108",
      "inputName": "width",
      "type": "scalar"
    },
    "height": {
      "nodeId": "108",
      "inputName": "height",
      "type": "scalar"
    },
    "frames": {
      "nodeId": "108",
      "inputName": "length",
      "type": "scalar"
    },
    "seed": {
