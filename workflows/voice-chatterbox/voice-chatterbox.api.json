{
  "1": {
    "class_type": "FL_ChatterboxMultilingualTTS",
    "inputs": {
      "text": "",
      "language": "English (en)",
      "exaggeration": 0.5,
      "cfg_weight": 0.5,
      "temperature": 0.8,
      "repetition_penalty": 2,
      "min_p": 0.05,
      "top_p": 1,
      "seed": 0,
      "audio_prompt": ["2", 0],
      "use_cpu": false,
      "keep_model_loaded": false
    },
    "_meta": { "title": "Speech" }
  },
  "2": {
    "class_type": "LoadAudio",
    "inputs": { "audio": "voice.mp3" },
    "_meta": { "title": "Voice to clone" }
  },
  "3": {
    "class_type": "SaveAudioMP3",
    "inputs": {
      "audio": ["1", 0],
      "filename_prefix": "audio/rosesfield-voice",
      "quality": "V0"
    },
    "_meta": { "title": "Audio" }
  }
}
