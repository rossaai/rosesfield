{
  "name": "lipsync-clip-infinitetalk",
  "title": "Lip sync: a clip redubbed to new audio with InfiniteTalk",
  "description": "Makes the person in your clip speak your audio with InfiniteTalk through the ComfyUI-WanVideoWrapper nodes on Wan 2.1 I2V 14B, keeping the clip's motion, then trims the video to the length of the audio. Built from the wrapper's example wanvideo_2_1_14B_V2V_InfiniteTalk_example_02.",
  "mediaType": "video",
  "openSource": true,
  "models": [
    "Wan2_1-I2V-14B-480p_fp8_e4m3fn_scaled_KJ.safetensors",
    "Wan2_1-InfiniTetalk-Single_fp16.safetensors",
    "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
    "wav2vec2-chinese-base_fp16.safetensors",
    "clip_vision_h.safetensors",
    "umt5-xxl-enc-bf16.safetensors",
    "Wan2_1_VAE_bf16.safetensors"
  ],
  "requiresCustomNodes": ["comfyui-wanvideowrapper"],
  "inputBindings": {
    "clip": {
      "nodeId": "1",
      "inputName": "file",
      "type": "cloud-asset"
    },
    "audio": {
      "nodeId": "2",
      "inputName": "audio",
      "type": "cloud-asset"
    },
    "seed": {
      "nodeId": "21",
      "inputName": "seed",
      "type": "scalar"
    },
    "resizeWidth": {
      "nodeId": "4",
      "inputName": "width",
      "type": "scalar"
    },
    "resizeHeight": {
      "nodeId": "4",
      "inputName": "height",
      "type": "scalar"
    },
    "width": {
      "nodeId": "19",
      "inputName": "width",
      "type": "scalar"
    },
    "height": {
      "nodeId": "19",
      "inputName": "height",
      "type": "scalar"
    },
    "frames": {
      "nodeId": "15",
      "inputName": "num_frames",
      "type": "scalar"
    },
    "length": {
      "nodeId": "900",
      "inputName": "length",
      "type": "scalar"
    }
  },
  "outputs": [
    {
      "nodeId": "902",
      "key": "images",
      "kind": "video"
    }
  ]
}
