{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "clip.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["1", 0]
    }
  },
  "3": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["2", 0]
    }
  },
  "4": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(1080, min(a, b))",
      "values.a": ["3", 0],
      "values.b": ["3", 1]
    }
  },
  "5": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["2", 0],
      "resize_type": "scale shorter dimension",
      "scale_method": "area",
      "resize_type.shorter_size": ["4", 1]
    }
  },
  "6": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["5", 0],
      "resize_type": "scale to multiple",
      "scale_method": "area",
      "resize_type.multiple": 2
    }
  },
  "7": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["6", 0]
    }
  },
  "8": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "9": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": ["8", 0],
      "image": ["6", 0]
    }
  },
  "10": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": ["7", 0],
      "height": ["7", 1],
      "batch_size": ["7", 2],
      "color": 45376
    }
  },
  "11": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["10", 0],
      "source": ["6", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["9", 0]
    }
  },
  "12": {
    "class_type": "PrimitiveBoolean",
    "inputs": {
      "value": true
    }
  },
  "13": {
    "class_type": "ComfySwitchNode",
    "inputs": {
      "switch": ["12", 0],
      "on_true": ["2", 1]
    }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": ["2", 2],
      "audio": ["13", 0]
    }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "video-edit/background",
      "format": "mp4",
      "format.codec": "h264"
    }
  }
}
