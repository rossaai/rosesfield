{
  "name": "video-edit-extend-wan-2-2",
  "title": "Video edit: extend a clip with Wan 2.2 14B",
  "description": "Takes the last frame of your clip, resampled to 16 frames per second, renders 1 to 4 more seconds from it with Wan 2.2 I2V A14B, and joins them to your clip, with its sound kept or left out.",
  "mediaType": "video",
  "openSource": true,
  "models": ["Wan-AI/Wan2.2-I2V-A14B"],
  "requiresCustomNodes": [],
  "inputBindings": {
    "source": {
      "nodeId": "1",
      "inputName": "file",
      "type": "cloud-asset"
    },
    "keepSound": {
      "nodeId": "22",
      "inputName": "value",
      "type": "scalar"
    },
    "shorterSide": {
      "nodeId": "10",
      "inputName": "resize_type.shorter_size",
      "type": "scalar"
    },
    "frames": {
      "nodeId": "98",
      "inputName": "length",
      "type": "scalar"
    },
    "prompt": {
      "nodeId": "93",
      "inputName": "text",
      "type": "scalar"
    },
    "seed": {
      "nodeId": "86",
      "inputName": "noise_seed",
      "type": "scalar"
    }
  },
  "outputs": [
    {
      "nodeId": "25",
      "key": "images",
      "kind": "video"
    }
  ]
}
