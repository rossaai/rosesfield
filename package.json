{
  "name": "rosesfield",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' --filter './services/*' dev",
    "build": "bun run --filter './apps/*' --filter './services/*' build",
    "start": "bun run --filter @rosesfield/platform build && bun run --filter @rosesfield/gateway start",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter './apps/*' --filter './services/*' --filter './packages/*' typecheck",
    "lint": "biome check . && depcruise apps services packages scripts --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "test": "bun run test:bun && bun run test:dom",
    "test:bun": "bun --bun vitest run --project '!ui' --project '!platform'",
    "test:dom": "vitest run --project ui --project platform",
    "catalog:sync": "bun packages/catalog/scripts/catalog-sync.ts",
    "prices:sync": "bun packages/generation/scripts/node-prices-sync.ts && bun packages/agent/scripts/router-chat-rates-sync.ts",
    "generated:check": "bun scripts/checks/generated-files/check-generated-files.ts",
    "copy:check": "bun scripts/checks/typed-copy/check-typed-copy.ts",
    "glob:check": "bun scripts/checks/glob-calls/check-glob-calls.ts",
    "motion:check": "bun scripts/checks/motion-presets/check-motion-presets.ts",
    "docs:check": "bun scripts/checks/doc-links/check-doc-links.ts",
    "ui:add": "cd apps/platform && shadcn add",
    "gate": "bun run catalog:sync && bun run generated:check && bun run copy:check && bun run glob:check && bun run motion:check && bun run docs:check && bun run typecheck && bun run lint && bun run test",
    "deploy": "bun scripts/deploy/deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.3",
    "dependency-cruiser": "18.6.0",
    "jsdom": "30.1.3",
    "shadcn": "4.22.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
