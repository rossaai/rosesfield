# Every setting is optional. With none, you paste your Comfy key in Settings.

# Your Comfy key. Every run spends credits from it.
COMFY_API_KEY=

# Leave empty for Comfy Cloud. Set it to the address of comfy-api-proxy in front of your own ComfyUI.
COMFY_BASE_URL=

# The port the server listens on. The default is 8787.
PORT=
