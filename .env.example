# Copy this file to .env and fill in the values.

# Your key from the Comfy platform. Every run spends it.
COMFY_API_KEY=

# Leave empty for Comfy Cloud. Set it to reach your own ComfyUI.
COMFY_BASE_URL=

# The owner token. Every request must carry it. Optional when HOST is 127.0.0.1.
# A server that listens beyond 127.0.0.1 without it refuses to start.
OWNER_TOKEN=

# The address and port the server listens on.
HOST=127.0.0.1
PORT=8787

# The folder that holds the SQLite file and your assets on this machine.
DATA_DIR=./data

# The agent's model. It must be an open-weights model.
# A server that speaks the OpenAI API: its base URL, the model id it serves and its key, if it needs one.
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=

# Workers AI without a base URL: set cloudflare-workers-ai here, a @cf/ model id above and a Cloudflare API token as the key.
# This path also needs CLOUDFLARE_ACCOUNT_ID.
AGENT_PROVIDER=
